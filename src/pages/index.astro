---
import { getCollection } from "astro:content";

import TopicCard from "../components/TopicCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { internalUrl } from "../lib/internal-url";

const topics = (await getCollection("topics", ({ data }) => data.status === "published")).sort(
  (left, right) => right.data.last_updated.valueOf() - left.data.last_updated.valueOf(),
);
const childTopics = topics.filter(({ data }) => data.audience === "child");
const adultTopics = topics.filter(({ data }) => data.audience === "adult");
const reviewUrl = internalUrl("review/", import.meta.env.BASE_URL);
---

<BaseLayout>
  <section class="home-hero">
    <div>
      <p class="eyebrow">Skupaj vprašamo. Skupaj odkrijemo.</p>
      <h1>Kaj bomo danes odkrili?</h1>
      <p>
        Interaktivne zgodbe v slovenščini pomagajo otrokom in odraslim raziskovati,
        razumeti in si zapomniti.
      </p>
      <a class="button" href="#teme">Izberi temo</a>
    </div>
    <div class="home-hero__orbit" aria-hidden="true">
      <span class="home-hero__earth">🌍</span>
      <span class="home-hero__moon">🌙</span>
    </div>
  </section>

  <section class="daily-challenge" aria-labelledby="daily-challenge-title">
    <div>
      <p class="eyebrow">🧠 Današnji izziv</p>
      <h2 id="daily-challenge-title">Kaj je ostalo v spominu?</h2>
      <p>Pet kratkih vprašanj iz tem, ki si jih že prebral. Vsak profil ima svoj napredek.</p>
    </div>
    <a class="button" href={reviewUrl}>Začni ponavljanje</a>
  </section>

  <div class="topic-library" id="teme">
    {
      childTopics.length > 0 && (
        <section class="topic-list" aria-labelledby="child-topics-title">
          <div class="section-heading">
            <p class="eyebrow">Knjižnica</p>
            <h2 id="child-topics-title">Za otroke</h2>
          </div>
          <div class="topic-grid">
            {childTopics.map(({ data }) => (
              <TopicCard
                title={data.title}
                slug={data.slug}
                description={data.description}
                category={data.category}
                audience={data.audience}
                estimatedMinutes={data.estimated_minutes}
              />
            ))}
          </div>
        </section>
      )
    }
    {
      adultTopics.length > 0 && (
        <section class="topic-list" aria-labelledby="adult-topics-title">
          <div class="section-heading">
            <p class="eyebrow">Knjižnica</p>
            <h2 id="adult-topics-title">Za odrasle</h2>
          </div>
          <div class="topic-grid">
            {adultTopics.map(({ data }) => (
              <TopicCard
                title={data.title}
                slug={data.slug}
                description={data.description}
                category={data.category}
                audience={data.audience}
                estimatedMinutes={data.estimated_minutes}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
