---
import "../styles/global.css";
import ProfilePicker from "../components/ProfilePicker.astro";
import PwaStatus from "../components/PwaStatus.astro";
import { internalUrl } from "../lib/internal-url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Družinsko učenje",
  description = "Interaktivne zgodbe za radovedne družine.",
} = Astro.props;
const pageTitle = title === "Družinsko učenje" ? title : `${title} · Družinsko učenje`;
const homeUrl = internalUrl("", import.meta.env.BASE_URL);
const topicsUrl = internalUrl("#teme", import.meta.env.BASE_URL);
const reviewUrl = internalUrl("review/", import.meta.env.BASE_URL);
const aboutUrl = internalUrl("about/", import.meta.env.BASE_URL);
const manifestUrl = internalUrl("manifest.webmanifest", import.meta.env.BASE_URL);
const faviconUrl = internalUrl("favicon.svg", import.meta.env.BASE_URL);
const appleTouchIconUrl = internalUrl("icons/apple-touch-icon.png", import.meta.env.BASE_URL);
const currentPath = Astro.url.pathname;
const isHome = currentPath === internalUrl("", import.meta.env.BASE_URL);
const isTopics = currentPath.startsWith(internalUrl("topics/", import.meta.env.BASE_URL));
const isReview = currentPath.startsWith(reviewUrl);
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173f4f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href={manifestUrl} />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Preskoči na vsebino</a>
    <header class="site-header">
      <a class="site-brand" href={homeUrl} aria-label="Družinsko učenje, domača stran">
        <span aria-hidden="true">✦</span>
        Družinsko učenje
      </a>
      <nav aria-label="Glavna navigacija">
        <a href={topicsUrl}>Teme</a>
        <a href={reviewUrl}>Ponovi</a>
        <a href={aboutUrl}>O projektu</a>
      </nav>
      <ProfilePicker />
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p>Znanje ostane v Git repozitoriju. Osebni napredek bo ostal na napravi.</p>
    </footer>
    <nav class="mobile-nav" aria-label="Mobilna navigacija">
      <a href={homeUrl} aria-current={isHome ? "page" : undefined}><span aria-hidden="true">⌂</span> Domov</a>
      <a href={topicsUrl} aria-current={isTopics ? "page" : undefined}><span aria-hidden="true">▤</span> Teme</a>
      <a href={reviewUrl} aria-current={isReview ? "page" : undefined}><span aria-hidden="true">🧠</span> Ponovi</a>
    </nav>
    {import.meta.env.PROD && <PwaStatus />}
  </body>
</html>
